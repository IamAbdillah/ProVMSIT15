@model IEnumerable<ProVMSIT15.Models.PurchaseRequisition>
@{
    ViewData["Title"] = "Requisition Management";
    ViewData["BreadcrumbModule"] = "Purchase Requisition";
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
}
<div class="provms-page-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-receipt fs-3"></i>
            <div>
                <h4 class="mb-0 fw-bold">Requisition Management</h4>
                <small class="opacity-75">Track all purchase requisitions through the full workflow pipeline</small>
            </div>
        </div>
        <a asp-controller="Catalog" asp-action="Marketplace" class="btn btn-warning fw-semibold">
            <i class="bi bi-shop me-1"></i>Browse Marketplace
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="provms-stat-card amber">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="stat-label">Pending Finance</div><div class="stat-value mt-1">@Model.Count(r => r.WorkflowStatus == WorkflowStatus.Pending_Finance)</div></div>
                <i class="bi bi-hourglass-split stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="provms-stat-card blue">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="stat-label">In Transit</div><div class="stat-value mt-1">@Model.Count(r => r.WorkflowStatus == WorkflowStatus.In_Transit)</div></div>
                <i class="bi bi-truck stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="provms-stat-card green">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="stat-label">Delivered</div><div class="stat-value mt-1">@Model.Count(r => r.WorkflowStatus == WorkflowStatus.Delivered)</div></div>
                <i class="bi bi-box-seam stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="provms-stat-card red">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="stat-label">Total Spend</div><div class="stat-value mt-1" style="font-size:1.2rem">&#8369;@Model.Where(r => r.WorkflowStatus != WorkflowStatus.Archived).Sum(r => r.TotalCalculatedAmount).ToString("N0")</div></div>
                <i class="bi bi-cash-stack stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<!-- ── MATERIAL RECEIPT CONFIRMATION MODAL ─────────────────────────── -->
<div id="receiptModal" style="display:none;position:fixed;inset:0;z-index:9999;backdrop-filter:blur(4px);background:rgba(15,23,42,0.6);align-items:center;justify-content:center">
    <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;box-shadow:0 25px 60px rgba(0,0,0,0.6);width:100%;max-width:480px;margin:auto;padding:2rem;position:relative">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div style="background:#f59e0b22;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="bi bi-box-seam" style="font-size:1.3rem;color:#f59e0b"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-white">Confirm Material Receipt</h5>
                <small style="color:#94a3b8">This action cannot be undone</small>
            </div>
        </div>
        <p style="color:#94a3b8;font-size:.9rem;line-height:1.6;margin-bottom:.5rem">
            You are confirming physical receipt of:
        </p>
        <div style="background:#0f172a;border:1px solid #334155;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem">
            <div class="fw-semibold text-white" id="modalReqId" style="font-size:.85rem;font-family:monospace"></div>
            <div style="color:#94a3b8;font-size:.85rem" id="modalItemName"></div>
            <div style="color:#64748b;font-size:.8rem" id="modalVendorName"></div>
        </div>
        <p style="color:#f59e0b;font-size:.82rem;background:#f59e0b11;border:1px solid #f59e0b33;border-radius:6px;padding:.6rem .9rem;margin-bottom:1.5rem">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            After confirming, you will be <strong>required to complete a mandatory supplier evaluation</strong> before this transaction is closed.
        </p>
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" id="modalCancelBtn"
                    style="border:1px solid #475569;color:#94a3b8;background:transparent;border-radius:8px;padding:.5rem 1.25rem;font-weight:600;transition:background .2s"
                    onmouseenter="this.style.background='#1e293b'" onmouseleave="this.style.background='transparent'"
                    onclick="closeReceiptModal()">
                Cancel
            </button>
            <button type="button" id="modalConfirmBtn"
                    style="background:#4f46e5;color:#fff;border:none;border-radius:8px;padding:.5rem 1.5rem;font-weight:600;transition:background .2s"
                    onmouseenter="this.style.background='#4338ca'" onmouseleave="this.style.background='#4f46e5'"
                    onclick="submitReceiptForm()">
                <i class="bi bi-check-lg me-1"></i>Confirm Receipt
            </button>
        </div>
    </div>
</div>

@if (!Model.Any())
{
<div class="provms-card">
    <div class="provms-empty-state">
        <i class="bi bi-receipt empty-icon"></i>
        <h5>No Requisitions Yet</h5>
        <p>You haven't placed any purchase requisitions. Browse the marketplace to get started.</p>
        <a asp-controller="Catalog" asp-action="Marketplace" class="btn btn-primary btn-sm">
            <i class="bi bi-shop me-2"></i>Browse Marketplace
        </a>
    </div>
</div>
}
else
{
<div class="provms-card p-0">
    <div class="card-section-header">
        <i class="bi bi-list-check text-primary"></i>
        <h6>Transaction Ledger</h6>
        <span class="badge ms-auto" style="background:#dbeafe;color:#1e40af">@Model.Count() records</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover provms-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Vendor</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th>Encumbered</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model)
                {
                var cls = req.WorkflowStatus == WorkflowStatus.Pending_Finance ? "badge-pending" :
                          req.WorkflowStatus == WorkflowStatus.Delivered ? "badge-delivered" :
                          req.WorkflowStatus == WorkflowStatus.Archived ? "badge-archived" : "badge-workflow";
                var icon = req.WorkflowStatus == WorkflowStatus.Pending_Finance ? "bi-hourglass-split" :
                           req.WorkflowStatus == WorkflowStatus.Approved_Budget ? "bi-check-circle" :
                           req.WorkflowStatus == WorkflowStatus.PO_Issued ? "bi-file-text" :
                           req.WorkflowStatus == WorkflowStatus.In_Transit ? "bi-truck" :
                           req.WorkflowStatus == WorkflowStatus.Delivered ? "bi-box-seam" : "bi-archive";
                <tr @(req.WorkflowStatus == WorkflowStatus.In_Transit && req.RequesterID == currentUserId ? "class=table-warning" : "")>
                    <td><code class="small">REQ-@req.ID.ToString("D4")</code></td>
                    <td>
                        <div class="fw-semibold">@req.Item?.ItemName</div>
                        <small class="text-muted">@req.Requester?.FullName</small>
                    </td>
                    <td class="small">@req.Item?.Vendor?.CompanyName</td>
                    <td>@req.Quantity</td>
                    <td class="fw-bold text-primary">&#8369;@req.TotalCalculatedAmount.ToString("N2")</td>
                    <td>
                        @if (req.IsEncumbered) { <span class="badge bg-success"><i class="bi bi-lock-fill me-1"></i>Locked</span> }
                        else { <span class="badge bg-light text-dark border">Free</span> }
                    </td>
                    <td>
                        <span class="status-badge @cls">
                            <i class="bi @icon"></i>
                            @req.WorkflowStatus.ToString().Replace("_", " ")
                        </span>
                    </td>
                    <td class="small text-muted">@req.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (req.WorkflowStatus == WorkflowStatus.In_Transit && req.RequesterID == currentUserId)
                        {
                        <form id="receiptForm_@req.ID" asp-controller="Catalog" asp-action="ConfirmReceipt" method="post" style="display:none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.ID" />
                        </form>
                        <button type="button" class="btn-approve btn btn-sm fw-semibold"
                                onclick="openReceiptModal('@req.ID', 'REQ-@req.ID.ToString("D4")', '@req.Item?.ItemName', '@req.Item?.Vendor?.CompanyName')">
                            <i class="bi bi-box-seam me-1"></i>Confirm Material Receipt
                        </button>
                        }
                        else if (req.WorkflowStatus == WorkflowStatus.Delivered && req.Evaluation == null && req.RequesterID == currentUserId)
                        {
                        <a asp-controller="Evaluation" asp-action="Submit"
                           asp-route-requisitionId="@req.ID"
                           class="btn btn-sm btn-warning fw-semibold">
                            <i class="bi bi-star me-1"></i>Pending Evaluation
                        </a>
                        }
                        else if (req.Evaluation != null)
                        {
                        <span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>Reviewed</span>
                        }
                        else
                        {
                        <span class="text-muted small">—</span>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

@section Scripts {
<script>
var _activeReceiptFormId = null;

function openReceiptModal(reqId, reqLabel, itemName, vendorName) {
    _activeReceiptFormId = 'receiptForm_' + reqId;
    document.getElementById('modalReqId').textContent      = reqLabel;
    document.getElementById('modalItemName').textContent   = itemName;
    document.getElementById('modalVendorName').textContent = vendorName;
    var modal = document.getElementById('receiptModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.getElementById('modalConfirmBtn').focus();
}

function closeReceiptModal() {
    document.getElementById('receiptModal').style.display = 'none';
    document.body.style.overflow = '';
    _activeReceiptFormId = null;
}

function submitReceiptForm() {
    if (_activeReceiptFormId) {
        var btn = document.getElementById('modalConfirmBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing\u2026';
        document.getElementById(_activeReceiptFormId).submit();
    }
}

document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('receiptModal').addEventListener('click', function (e) {
        if (e.target === this) e.stopPropagation();
    });
});
</script>
}

@model ProVMSIT15.Models.ViewModels.VendorOnboardingViewModel
@{ ViewData["Title"] = "Vendor Registration"; Layout = "_Layout"; }

<div class="min-vh-100 d-flex align-items-center justify-content-center py-4" style="background: linear-gradient(135deg, #0f1c33 0%, #1e3a5f 60%, #2563eb 100%);">
    <div class="col-12 col-md-9 col-lg-7 px-3">
        <div class="text-center mb-4">
            <i class="bi bi-building-add text-warning" style="font-size:2.5rem"></i>
            <h3 class="text-white fw-bold mt-2 mb-0">Vendor Onboarding</h3>
            <p class="text-light opacity-75 small">Complete all 3 steps to register your company</p>
        </div>

        <div class="wizard-steps mb-4">
            <div class="wizard-step active" id="ws-1">
                <div class="wizard-step-num">1</div>
                <div class="wizard-step-label"><i class="bi bi-building me-1"></i>Corporate Profile</div>
            </div>
            <div class="wizard-step-connector"></div>
            <div class="wizard-step" id="ws-2">
                <div class="wizard-step-num">2</div>
                <div class="wizard-step-label"><i class="bi bi-file-earmark-pdf me-1"></i>Document Vault</div>
            </div>
            <div class="wizard-step-connector"></div>
            <div class="wizard-step" id="ws-3">
                <div class="wizard-step-num">3</div>
                <div class="wizard-step-label"><i class="bi bi-table me-1"></i>Product Catalog</div>
            </div>
        </div>

        <div class="card border-0 shadow-lg" style="border-radius:16px">
            <div class="card-body p-4">
                <form asp-controller="Vendor" asp-action="Onboarding" method="post" enctype="multipart/form-data" id="onboardingForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    @* STEP 1: Corporate Profile *@
                    <div class="wizard-panel active" id="step-1">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge rounded-pill" style="background:#1a2b4a;color:white;font-size:.8rem;padding:.35rem .7rem">Step 1</span>
                            <span class="fw-bold" style="color:#1a2b4a">Corporate Profile</span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name <span class="text-danger">*</span></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Acme Supplies Pte. Ltd." required />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="TaxID" class="form-label fw-semibold small">Tax ID / Registration No. <span class="text-danger">*</span></label>
                                <input asp-for="TaxID" class="form-control" placeholder="e.g. 202312345A" required />
                                <span asp-validation-for="TaxID" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactEmail" class="form-label fw-semibold small">Contact Email <span class="text-danger">*</span></label>
                                <input asp-for="ContactEmail" class="form-control" placeholder="vendor@company.com" required />
                                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold small">Portal Password <span class="text-danger">*</span></label>
                                <input asp-for="Password" id="Password" class="form-control" placeholder="Min. 8 characters" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm Password <span class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder="Repeat password" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    @* STEP 2: Document Vault *@
                    <div class="wizard-panel" id="step-2">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge rounded-pill" style="background:#1a2b4a;color:white;font-size:.8rem;padding:.35rem .7rem">Step 2</span>
                            <span class="fw-bold" style="color:#1a2b4a">Digital Document Vault</span>
                        </div>
                        <p class="text-muted small mb-3">Upload your business registration certificate or accreditation documents. <strong>PDF only, max 5MB.</strong></p>
                        <div class="drag-drop-zone" id="dropZone">
                            <i class="bi bi-cloud-arrow-up fs-1 text-muted d-block mb-3"></i>
                            <p class="drop-label fw-semibold text-muted mb-1">Drag &amp; drop your PDF here</p>
                            <p class="text-muted small mb-0">or click to browse</p>
                            <input asp-for="DocumentFile" id="DocumentFile" type="file" accept=".pdf" class="d-none" />
                        </div>
                        <div id="docPreviewWrap" class="mt-3 d-none">
                            <p class="small fw-semibold text-success"><i class="bi bi-check-circle me-1"></i>Document selected:</p>
                            <iframe id="docPreview" class="doc-preview-frame"></iframe>
                        </div>
                    </div>

                    @* STEP 3: Product Catalog *@
                    <div class="wizard-panel" id="step-3">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge rounded-pill" style="background:#1a2b4a;color:white;font-size:.8rem;padding:.35rem .7rem">Step 3</span>
                            <span class="fw-bold" style="color:#1a2b4a">Product Catalog</span>
                        </div>
                        <p class="text-muted small mb-3">Add the items your company offers. You can add more after approval.</p>
                        <div class="table-responsive">
                            <table class="table table-bordered catalog-table-editor align-middle" id="catalogTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40%">Item Name</th>
                                        <th style="width:28%">Category</th>
                                        <th style="width:20%">Unit Price (&#8369;)</th>
                                        <th style="width:12%"></th>
                                    </tr>
                                </thead>
                                <tbody id="catalogTbody"></tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addCatalogRow()">
                            <i class="bi bi-plus-circle me-2"></i>Add Row
                        </button>
                        <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>At least one item recommended.</p>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" id="btnPrev" onclick="prevStep()" style="display:none">
                            <i class="bi bi-arrow-left me-2"></i>Previous
                        </button>
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn fw-semibold px-4" id="btnNext" onclick="nextStep()" style="background:#1a2b4a;color:white">
                                Next <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                            <button type="submit" class="btn btn-success fw-semibold px-4" id="btnSubmit" style="display:none">
                                <i class="bi bi-send me-2"></i>Submit Registration
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="#" onclick="openDiscardModal('/Auth/Login');return false;" class="text-light small opacity-75">Already registered? Sign in</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('DocumentFile').addEventListener('change', function() {
    const file = this.files[0];
    if (file) {
        const url = URL.createObjectURL(file);
        const preview = document.getElementById('docPreview');
        const wrap = document.getElementById('docPreviewWrap');
        preview.src = url;
        wrap.classList.remove('d-none');
    }
});
</script>
}

@{ ViewData["Title"] = "Access Denied"; Layout = "_Layout"; }

<div class="container-fluid px-4 py-5 text-center">
    <div class="py-5">
        <div class="mb-4"><i class="bi bi-shield-lock-fill text-danger" style="font-size:5rem"></i></div>
        <h1 class="fw-bold text-danger mb-2">403 — Access Forbidden</h1>
        <p class="text-muted fs-5 mb-4">You do not have permission to access this resource.</p>
        <p class="text-muted small mb-4">If you believe this is an error, contact your system administrator.</p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary me-2">
            <i class="bi bi-box-arrow-in-right me-2"></i>Return to Login
        </a>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house me-2"></i>Go to Dashboard
        </a>
    </div>
</div>

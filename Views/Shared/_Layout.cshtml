<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProVMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/provms.css?v=20260521f" />
    <style>
      /* CRITICAL LAYOUT OVERRIDE */
      html,body{margin:0!important;padding:0!important;overflow:hidden!important;width:100%!important;height:100%!important}
      .provms-shell{position:fixed!important;top:0!important;left:0!important;right:0!important;bottom:0!important;display:flex!important;flex-direction:row!important;overflow:hidden!important}
      .provms-sidebar{width:260px!important;min-width:260px!important;max-width:260px!important;flex:0 0 260px!important;overflow:hidden!important}
      .provms-sidebar.collapsed{width:64px!important;min-width:64px!important;max-width:64px!important;flex:0 0 64px!important}
      .provms-content-area{flex:1 1 auto!important;min-width:0!important;overflow-y:auto!important;overflow-x:hidden!important;display:flex!important;flex-direction:column!important;height:100%!important}
    </style>
</head>
<body class="provms-body">
@if (User.Identity?.IsAuthenticated == true)
{
<div class="provms-shell">
  <!-- ═══ DARK LEFT SIDEBAR ═══ -->
  <aside class="provms-sidebar d-flex flex-column" id="provmsSidebar">
    <!-- Brand -->
    <div class="sidebar-brand d-flex align-items-center gap-2 px-3 py-4">
      <i class="bi bi-box-seam-fill fs-4 text-warning"></i>
      <span class="fw-bold fs-5 text-white sidebar-label">ProVMS</span>
    </div>
    <hr class="sidebar-divider mx-3 my-0">

    <!-- Nav -->
    <nav class="sidebar-nav flex-grow-1 py-2 overflow-auto">
      @{ var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
         var act  = ViewContext.RouteData.Values["action"]?.ToString() ?? ""; }

      @if (User.IsInRole("Vendor"))
      {
      <!-- ═══ VENDOR PORTAL ═══ -->
      <div class="sidebar-section-label px-3 pt-3 pb-1">VENDOR PORTAL</div>
      <a class="sidebar-link @(act == "Profile" ? "active" : "")"
         asp-controller="Vendor" asp-action="Profile">
        <i class="bi bi-person-badge"></i><span class="sidebar-label">Vendor Profile</span>
      </a>
      <a class="sidebar-link @(act == "VendorOrders" ? "active" : "")"
         asp-controller="Catalog" asp-action="VendorOrders">
        <i class="bi bi-truck"></i><span class="sidebar-label">My Orders</span>
      </a>
      <a class="sidebar-link @(act == "DeliveryTracking" ? "active" : "")"
         asp-controller="Catalog" asp-action="DeliveryTracking">
        <i class="bi bi-geo-alt"></i><span class="sidebar-label">Delivery Tracking</span>
      </a>
      }
      else
      {
      <div class="accordion accordion-flush" id="sideAccordion">

        @* ── MODULE 0: DASHBOARD — Admin R | Finance R | Procurement R (User=X, Vendor=X) *@
        @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement"))
        {
        <a class="sidebar-link @(ctrl == "Dashboard" && act == "Index" ? "active" : "")"
           asp-controller="Dashboard" asp-action="Index">
          <i class="bi bi-house-door-fill"></i><span class="sidebar-label">Dashboard</span>
        </a>
        <hr class="sidebar-divider mx-3 my-1">
        }

        @* ── MODULE 1: VENDOR ACCREDITATION
             Accreditation Desk: Admin C,R,U,D | Procurement R,U  (Finance=X, User=X, Vendor=X)
             Vendor Directory:   Admin C,R,U   | Procurement C,R,U | Finance R | User R (Vendor=X) *@
        @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement") || User.IsInRole("User"))
        {
        <div class="accordion-item sidebar-module">
          <h2 class="accordion-header">
            <button class="accordion-button sidebar-module-btn @(ctrl == "Vendor" ? "" : "collapsed")"
                    type="button" data-bs-toggle="collapse" data-bs-target="#mod1">
              <i class="bi bi-building-check me-2"></i>
              <span class="sidebar-label">Vendor Accreditation</span>
            </button>
          </h2>
          <div id="mod1" class="accordion-collapse collapse @(ctrl == "Vendor" ? "show" : "")"
               data-bs-parent="#sideAccordion">
            <div class="accordion-body p-0">
              @if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
              {
              <a class="sidebar-sublink @(act == "AccreditationDesk" ? "active" : "")"
                 asp-controller="Vendor" asp-action="AccreditationDesk">
                <i class="bi bi-clipboard2-check"></i><span class="sidebar-label">Vendor Accreditation Desk</span>
              </a>
              }
              @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement") || User.IsInRole("User"))
              {
              <a class="sidebar-sublink @(act == "Directory" ? "active" : "")"
                 asp-controller="Vendor" asp-action="Directory">
                <i class="bi bi-grid-3x2-gap"></i><span class="sidebar-label">Vendor Directory</span>
              </a>
              }
            </div>
          </div>
        </div>
        }

        @* ── MODULE 2: PURCHASE REQUISITION
             Marketplace:       User R  (Admin=X, Finance=X, Procurement=X, Vendor=X)
             My Requests:       User C,R,U,D(own)  (all others=X)
             Approval Workflow: Finance R,U  (Admin=X per matrix — Finance approves, not Admin)
             PO Vault Full:     Admin R | Procurement R,U | Finance R
             PO Vault Own:      User R(own) | Vendor R,U(own)
             Delivery Tracking: Admin R | Procurement R,U | User R(own) | Vendor R,U(dispatch) — Finance=X *@
        @if (User.IsInRole("Finance") || User.IsInRole("Procurement") || User.IsInRole("User") || User.IsInRole("Admin"))
        {
        <div class="accordion-item sidebar-module">
          <h2 class="accordion-header">
            <button class="accordion-button sidebar-module-btn @(ctrl == "Catalog" ? "" : "collapsed")"
                    type="button" data-bs-toggle="collapse" data-bs-target="#mod2">
              <i class="bi bi-cart3 me-2"></i>
              <span class="sidebar-label">Purchase Requisition</span>
            </button>
          </h2>
          <div id="mod2" class="accordion-collapse collapse @(ctrl == "Catalog" ? "show" : "")"
               data-bs-parent="#sideAccordion">
            <div class="accordion-body p-0">
              @* Marketplace & My Requests: User only *@
              @if (User.IsInRole("User"))
              {
              <a class="sidebar-sublink @(act == "Marketplace" ? "active" : "")"
                 asp-controller="Catalog" asp-action="Marketplace">
                <i class="bi bi-shop"></i><span class="sidebar-label">Marketplace</span>
              </a>
              <a class="sidebar-sublink @(act == "MyRequests" ? "active" : "")"
                 asp-controller="Catalog" asp-action="MyRequests">
                <i class="bi bi-receipt"></i><span class="sidebar-label">My Requests</span>
              </a>
              }
              @* Approval Workflow: Finance only (R,U Approve/Reject) — Admin=X per matrix *@
              @if (User.IsInRole("Finance"))
              {
              <a class="sidebar-sublink @(act == "ApprovalWorkflow" ? "active" : "")"
                 asp-controller="Catalog" asp-action="ApprovalWorkflow">
                <i class="bi bi-check2-square"></i><span class="sidebar-label">Approval Workflow</span>
              </a>
              }
              @* PO Vault Full: Admin R | Procurement R,U *@
              @if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
              {
              <a class="sidebar-sublink @(act == "POVault" ? "active" : "")"
                 asp-controller="Catalog" asp-action="POVault">
                <i class="bi bi-file-earmark-text"></i><span class="sidebar-label">PO Vault</span>
              </a>
              }
              @* PO Vault Finance: R only *@
              @if (User.IsInRole("Finance"))
              {
              <a class="sidebar-sublink @(act == "POVault" ? "active" : "")"
                 asp-controller="Catalog" asp-action="POVault">
                <i class="bi bi-file-earmark-text"></i><span class="sidebar-label">PO Vault <span class="badge ms-1" style="font-size:.6rem;background:rgba(14,165,233,.15);color:#0369a1">Read</span></span>
              </a>
              }
              @* PO Vault Own Orders: User R(own) *@
              @if (User.IsInRole("User"))
              {
              <a class="sidebar-sublink @(act == "POVault" ? "active" : "")"
                 asp-controller="Catalog" asp-action="POVault">
                <i class="bi bi-file-earmark-text"></i><span class="sidebar-label">PO Vault (Own Orders)</span>
              </a>
              }
              @* Delivery Tracking: Admin R | Procurement R,U | User R(own) — Finance=X *@
              @if (User.IsInRole("Admin") || User.IsInRole("Procurement") || User.IsInRole("User"))
              {
              <a class="sidebar-sublink @(act == "DeliveryTracking" ? "active" : "")"
                 asp-controller="Catalog" asp-action="DeliveryTracking">
                <i class="bi bi-truck"></i><span class="sidebar-label">Delivery Tracking</span>
              </a>
              }
            </div>
          </div>
        </div>
        }

        @* ── MODULE 3: SUPPLIER EVALUATION
             Performance Evaluation (View All): Admin R | Procurement R,U | Finance R  (User=X, Vendor=X)
             Leaderboard:                       Admin R | Procurement R   | Finance R  (User=X, Vendor=X) *@
        @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement"))
        {
        <div class="accordion-item sidebar-module">
          <h2 class="accordion-header">
            <button class="accordion-button sidebar-module-btn @(ctrl == "Evaluation" ? "" : "collapsed")"
                    type="button" data-bs-toggle="collapse" data-bs-target="#mod3">
              <i class="bi bi-star me-2"></i>
              <span class="sidebar-label">Supplier Evaluation</span>
            </button>
          </h2>
          <div id="mod3" class="accordion-collapse collapse @(ctrl == "Evaluation" ? "show" : "")"
               data-bs-parent="#sideAccordion">
            <div class="accordion-body p-0">
              <a class="sidebar-sublink @(act == "Performance" ? "active" : "")"
                 asp-controller="Evaluation" asp-action="Performance">
                <i class="bi bi-bar-chart-steps"></i><span class="sidebar-label">Performance Evaluation</span>
              </a>
              <a class="sidebar-sublink @(act == "Leaderboard" ? "active" : "")"
                 asp-controller="Evaluation" asp-action="Leaderboard">
                <i class="bi bi-trophy"></i><span class="sidebar-label">Leaderboard</span>
              </a>
            </div>
          </div>
        </div>
        }

        @* ── MODULE 4: CONTRACT MANAGEMENT — Admin C,R,U,D | Procurement C,R,U | Finance R (User=X, Vendor=X) *@
        @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement"))
        {
        <a class="sidebar-link @(ctrl == "Contract" ? "active" : "")"
           asp-controller="Contract" asp-action="Lifecycle">
          <i class="bi bi-file-earmark-ruled"></i><span class="sidebar-label">Contract Management</span>
        </a>
        }

        @* ── MODULE 5: PROCUREMENT ANALYTICS — Admin R | Finance R | Procurement R (User=X, Vendor=X) *@
        @if (User.IsInRole("Admin") || User.IsInRole("Finance") || User.IsInRole("Procurement"))
        {
        <div class="accordion-item sidebar-module">
          <h2 class="accordion-header">
            @{ var mod5Active = (ctrl == "Dashboard" && act != "Index") || act == "Benchmarking"; }
            <button class="accordion-button sidebar-module-btn @(mod5Active ? "" : "collapsed")"
                    type="button" data-bs-toggle="collapse" data-bs-target="#mod5">
              <i class="bi bi-speedometer2 me-2"></i>
              <span class="sidebar-label">Procurement Analytics</span>
            </button>
          </h2>
          <div id="mod5" class="accordion-collapse collapse @(mod5Active ? "show" : "")"
               data-bs-parent="#sideAccordion">
            <div class="accordion-body p-0">
              <a class="sidebar-sublink @(act == "Reports" ? "active" : "")"
                 asp-controller="Dashboard" asp-action="Reports">
                <i class="bi bi-file-bar-graph"></i><span class="sidebar-label">Reports &amp; Insights</span>
              </a>
              @* Budget Management: Finance only (Admin=X per matrix) *@
              @if (User.IsInRole("Finance"))
              {
              <a class="sidebar-sublink @(act == "BudgetManagement" ? "active" : "")"
                 asp-controller="Dashboard" asp-action="BudgetManagement">
                <i class="bi bi-wallet2"></i><span class="sidebar-label">Budget Management</span>
              </a>
              }
              @* Benchmarking: Admin R | Finance R | Procurement R *@
              <a class="sidebar-sublink @(act == "Benchmarking" ? "active" : "")"
                 asp-controller="Evaluation" asp-action="Benchmarking">
                <i class="bi bi-radar"></i><span class="sidebar-label">Benchmarking</span>
              </a>
              @* Financial Audit Trail: Admin R | Finance R (Procurement=X) *@
              @if (User.IsInRole("Admin") || User.IsInRole("Finance"))
              {
              <a class="sidebar-sublink @(act == "AuditTrail" ? "active" : "")"
                 asp-controller="Dashboard" asp-action="AuditTrail">
                <i class="bi bi-shield-lock-fill"></i><span class="sidebar-label">Financial Audit Trail</span>
              </a>
              }
              @* SLA Milestone Logs: Admin R | Finance R | Procurement R *@
              <a class="sidebar-sublink @(act == "SLALogs" ? "active" : "")"
                 asp-controller="Dashboard" asp-action="SLALogs">
                <i class="bi bi-alarm"></i><span class="sidebar-label">SLA Milestone Logs</span>
              </a>
            </div>
          </div>
        </div>
        }

        @* ── MODULE 6: USER MANAGEMENT — Admin C,R,U,D only *@
        @if (User.IsInRole("Admin"))
        {
        <hr class="sidebar-divider mx-3 my-1">
        <a class="sidebar-link @(ctrl == "UserManagement" ? "active" : "")"
           asp-controller="UserManagement" asp-action="Index">
          <i class="bi bi-people-fill"></i><span class="sidebar-label">User Management</span>
        </a>
        }

      </div>
      }
    </nav>

    <!-- Sidebar Footer -->
    <div class="sidebar-footer px-3 py-3 border-top border-secondary">
      <div class="d-flex align-items-center gap-2">
        <div class="provms-avatar-sm">@(User.Identity!.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "?")</div>
        <div class="sidebar-label overflow-hidden">
          <div class="text-white small fw-semibold text-truncate">@User.Identity.Name</div>
          <div class="text-secondary" style="font-size:.7rem">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- ═══ RIGHT CONTENT AREA ═══ -->
  <div class="provms-content-area">
    <!-- Top Header Bar -->
    <header class="provms-topbar d-flex align-items-center justify-content-between px-4 py-2">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-outline-secondary sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
          <i class="bi bi-list fs-5"></i>
        </button>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><span class="text-muted">ProVMS</span></li>
            @if (ViewData["BreadcrumbModule"] != null)
            {
            <li class="breadcrumb-item text-muted">@ViewData["BreadcrumbModule"]</li>
            }
            <li class="breadcrumb-item active fw-semibold">@ViewData["Title"]</li>
          </ol>
        </nav>
      </div>
      <div class="d-flex align-items-center gap-2">
        <!-- Notification Bell -->
        <div class="dropdown">
          <button class="btn btn-sm position-relative" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;width:36px;height:36px;padding:0" data-bs-toggle="dropdown" onclick="loadNotifications()" title="Notifications">
            <i class="bi bi-bell" style="font-size:.95rem;color:#475569"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notifBadge" style="display:none;font-size:.52rem;min-width:16px"></span>
          </button>
          <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg border-0" style="width:370px;max-height:440px;overflow-y:auto;border-radius:12px">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="background:#f8fafc">
              <span class="fw-bold small" style="color:#0f172a"><i class="bi bi-bell-fill me-2 text-primary"></i>Notifications</span>
              <button class="btn btn-link btn-sm p-0 text-primary fw-semibold" style="font-size:.78rem" onclick="markAllRead()">Mark all read</button>
            </div>
            <div id="notifList"><div class="text-center text-muted py-4 small"><i class="bi bi-hourglass-split d-block mb-2 fs-5"></i>Loading...</div></div>
          </div>
        </div>
        <!-- User Pill -->
        @{ var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ""; }
        <div class="topbar-user-pill">
          <div class="avatar">@(User.Identity!.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "?")</div>
          <span class="d-none d-md-inline text-truncate" style="max-width:120px">@User.Identity.Name</span>
          <span class="topbar-role-badge role-@roleVal">@roleVal</span>
        </div>
        <!-- Logout (intercepted by custom modal) -->
        <form id="globalLogoutForm" asp-controller="Auth" asp-action="Logout" method="post" class="m-0" style="display:none">
          @Html.AntiForgeryToken()
        </form>
        <button type="button" class="btn btn-sm" onclick="openLogoutModal()"
                style="background:#fee2e2;border:1px solid #fecaca;border-radius:8px;width:36px;height:36px;padding:0;color:#dc2626" title="Sign Out">
          <i class="bi bi-box-arrow-right"></i>
        </button>
      </div>
    </header>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
    <div class="px-4 pt-3">
      <div class="alert alert-success alert-dismissible fade show shadow-sm mb-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
    }
    @if (TempData["Error"] != null)
    {
    <div class="px-4 pt-3">
      <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
    }

    <main class="provms-main">
      @RenderBody()
    </main>
  </div>
</div>
}
@if (User.Identity?.IsAuthenticated != true)
{
<main>@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/provms.js?v=20260521g"></script>
<script>
  document.getElementById('sidebarToggle')?.addEventListener('click', function () {
    document.getElementById('provmsSidebar').classList.toggle('collapsed');
  });
</script>
@await RenderSectionAsync("Scripts", required: false)

<!-- ── LOGOUT CONFIRMATION MODAL ─────────────────────────────────────── -->
<div id="logoutModal" style="display:none;position:fixed;inset:0;z-index:10000;backdrop-filter:blur(4px);background:rgba(15,23,42,0.6);align-items:center;justify-content:center">
  <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;box-shadow:0 25px 60px rgba(0,0,0,0.6);width:100%;max-width:420px;margin:auto;padding:2rem">
    <div class="d-flex align-items-center gap-3 mb-3">
      <div style="background:#ef444422;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <i class="bi bi-box-arrow-right" style="font-size:1.3rem;color:#ef4444"></i>
      </div>
      <div>
        <h5 class="mb-0 fw-bold text-white">End Active Session?</h5>
        <small style="color:#94a3b8">You will need to re-authenticate</small>
      </div>
    </div>
    <p style="color:#94a3b8;font-size:.875rem;line-height:1.6;margin-bottom:1.5rem">
      Are you sure you want to log out of ProVMS? You will need to re-authenticate to review your notification hubs or manage active workflows.
    </p>
    <div class="d-flex gap-2 justify-content:end justify-content-end">
      <button type="button"
              style="border:1px solid #475569;color:#94a3b8;background:transparent;border-radius:8px;padding:.5rem 1.25rem;font-weight:600;transition:background .2s"
              onmouseenter="this.style.background='#334155'" onmouseleave="this.style.background='transparent'"
              onclick="closeLogoutModal()">Stay</button>
      <button type="button" id="logoutCommitBtn"
              style="background:#ef4444;color:#fff;border:none;border-radius:8px;padding:.5rem 1.5rem;font-weight:600;transition:background .2s"
              onmouseenter="this.style.background='#dc2626'" onmouseleave="this.style.background='#ef4444'"
              onclick="commitLogout()">
        <i class="bi bi-box-arrow-right me-1"></i>Log Out
      </button>
    </div>
  </div>
</div>

<!-- ── DISCARD DRAFT MODAL ───────────────────────────────────────────── -->
<div id="discardModal" style="display:none;position:fixed;inset:0;z-index:10000;backdrop-filter:blur(4px);background:rgba(15,23,42,0.6);align-items:center;justify-content:center">
  <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;box-shadow:0 25px 60px rgba(0,0,0,0.6);width:100%;max-width:420px;margin:auto;padding:2rem">
    <div class="d-flex align-items-center gap-3 mb-3">
      <div style="background:#f59e0b22;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <i class="bi bi-exclamation-triangle" style="font-size:1.3rem;color:#f59e0b"></i>
      </div>
      <div>
        <h5 class="mb-0 fw-bold text-white">Discard Draft Data?</h5>
        <small style="color:#94a3b8">This action cannot be undone</small>
      </div>
    </div>
    <p style="color:#94a3b8;font-size:.875rem;line-height:1.6;margin-bottom:1.5rem">
      Warning: Exiting this panel will completely clear your active line entries. This action cannot be undone.
    </p>
    <div class="d-flex gap-2 justify-content-end">
      <button type="button"
              style="border:1px solid #475569;color:#94a3b8;background:transparent;border-radius:8px;padding:.5rem 1.25rem;font-weight:600;transition:background .2s"
              onmouseenter="this.style.background='#334155'" onmouseleave="this.style.background='transparent'"
              onclick="closeDiscardModal()">Cancel</button>
      <button type="button" id="discardCommitBtn"
              style="background:#ef4444;color:#fff;border:none;border-radius:8px;padding:.5rem 1.5rem;font-weight:600;transition:background .2s"
              onmouseenter="this.style.background='#dc2626'" onmouseleave="this.style.background='#ef4444'"
              onclick="commitDiscard()">
        <i class="bi bi-trash me-1"></i>Discard
      </button>
    </div>
  </div>
</div>

<script>
var _discardTarget = null;

function openLogoutModal() {
  document.getElementById('logoutModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
  document.getElementById('logoutCommitBtn').focus();
}
function closeLogoutModal() {
  document.getElementById('logoutModal').style.display = 'none';
  document.body.style.overflow = '';
}
function commitLogout() {
  var btn = document.getElementById('logoutCommitBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Signing out…';
  document.getElementById('globalLogoutForm').submit();
}

function openDiscardModal(targetHref) {
  _discardTarget = targetHref;
  document.getElementById('discardModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
  document.getElementById('discardCommitBtn').focus();
}
function closeDiscardModal() {
  document.getElementById('discardModal').style.display = 'none';
  document.body.style.overflow = '';
  _discardTarget = null;
}
function commitDiscard() {
  if (_discardTarget) window.location.href = _discardTarget;
}

// Focus trap: backdrop click does NOT close either modal
document.addEventListener('DOMContentLoaded', function () {
  ['logoutModal','discardModal'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('click', function(e) { if (e.target === this) e.stopPropagation(); });
  });
});
</script>
</body>
</html>

@model IEnumerable<ProVMSIT15.Models.DepartmentBudget>
@{ ViewData["Title"] = "Budget Management"; Layout = "_Layout"; }

<div class="provms-page-header">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-wallet2 fs-3"></i>
        <div>
            <h4 class="mb-0 fw-bold">Department Budget Management</h4>
            <small class="opacity-75">Allocate and monitor departmental budgets for FY @DateTime.Now.Year</small>
        </div>
    </div>
</div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="provms-card p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>Allocate / Update Budget</h6>
                <form asp-controller="Dashboard" asp-action="AllocateBudget" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="departmentCode" id="deptCodeSelect" class="form-select" required onchange="fillDeptName(this.value)">
                            <option value="" disabled selected>— Select Department —</option>
                            <option value="IT">IT — Information Technology</option>
                            <option value="HR">HR — Human Resources</option>
                            <option value="FINANCE">FINANCE — Finance Department</option>
                            <option value="OPS">OPS — Operations</option>
                            <option value="PROCUREMENT">PROCUREMENT — Procurement Division</option>
                            <option value="SYS">SYS — System Administration</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Name <span class="text-danger">*</span></label>
                        <input type="text" name="departmentName" id="deptNameInput" class="form-control" placeholder="Auto-filled" required maxlength="100" readonly />
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Allocated Budget (PHP) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" name="allocated" class="form-control" placeholder="0.00" step="0.01" min="0" required />
                        </div>
                    </div>
                    <button type="submit" class="btn w-100 fw-bold" style="background:#1a2b4a;color:white">
                        <i class="bi bi-save me-2"></i>Save Budget Allocation
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-7">
            <div class="provms-card overflow-hidden">
                <div class="p-3 border-bottom bg-light">
                    <h6 class="fw-bold mb-0"><i class="bi bi-table me-2"></i>Current Allocations — FY @DateTime.Now.Year</h6>
                </div>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-wallet fs-2 d-block mb-2"></i>
                        <small>No budget records yet.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover provms-table mb-0">
                            <thead>
                                <tr>
                                    <th>Dept.</th>
                                    <th>Name</th>
                                    <th>Allocated</th>
                                    <th>Spent</th>
                                    <th>Remaining</th>
                                    <th>Usage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model)
                                {
                                    var pct = b.AllocatedBudget > 0 ? (double)(b.SpentAmount / b.AllocatedBudget * 100) : 0;
                                    var barCls = pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-success";
                                    <tr>
                                        <td><span class="badge bg-primary">@b.DepartmentCode</span></td>
                                        <td class="fw-semibold small">@b.DepartmentName</td>
                                        <td class="fw-bold">₱@b.AllocatedBudget.ToString("N2")</td>
                                        <td class="text-danger">₱@b.SpentAmount.ToString("N2")</td>
                                        <td class="fw-bold @(b.RemainingBudget < 0 ? "text-danger" : "text-success")">
                                            ₱@b.RemainingBudget.ToString("N2")
                                        </td>
                                        <td style="min-width:120px">
                                            <div class="d-flex align-items-center gap-1">
                                                <div class="progress flex-grow-1" style="height:8px">
                                                    <div class="progress-bar @barCls" style="width:@Math.Min(100, pct).ToString("F0")%"></div>
                                                </div>
                                                <span class="small text-muted">@pct.ToString("F0")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const deptNames = {
    'IT': 'Information Technology',
    'HR': 'Human Resources',
    'FINANCE': 'Finance Department',
    'OPS': 'Operations',
    'PROCUREMENT': 'Procurement Division',
    'SYS': 'System Administration'
};
function fillDeptName(code) {
    document.getElementById('deptNameInput').value = deptNames[code] || '';
}
</script>
}

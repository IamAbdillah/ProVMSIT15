@model List<ProVMSIT15.Models.Contract>
@{
    ViewData["Title"] = "Contract Lifecycle";
    ViewData["BreadcrumbModule"] = "Contract Management";
}
<div class="provms-page-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-arrow-repeat fs-3"></i>
            <div>
                <h4 class="mb-0 fw-bold">Contract Lifecycle</h4>
                <small class="opacity-75">Manage all vendor contracts from draft to termination</small>
            </div>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
        {
        <button class="btn btn-warning fw-semibold" data-bs-toggle="modal" data-bs-target="#newContractModal">
            <i class="bi bi-plus-circle me-1"></i>New Contract
        </button>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    @{
        var statuses = new[] { ("Draft", "badge-draft", "blue"), ("Active", "badge-active", "green"), ("UnderNegotiation", "badge-negotiation", "amber"), ("Expiring", "badge-expiring", "red") };
    }
    @foreach (var (s, cls, color) in statuses)
    {
    var count = Model.Count(c => c.Status.ToString() == s);
    <div class="col-sm-6 col-xl-3">
        <div class="provms-stat-card @color">
            <div class="d-flex justify-content-between align-items-start">
                <div><div class="stat-label">@s.Replace("UnderNegotiation","Under Negotiation")</div><div class="stat-value mt-1">@count</div></div>
                <i class="bi bi-file-earmark-ruled stat-icon"></i>
            </div>
        </div>
    </div>
    }
</div>

<div class="provms-card p-0">
    <div class="px-4 py-3 border-bottom d-flex align-items-center gap-2">
        <i class="bi bi-list-ul text-primary"></i>
        <h6 class="fw-bold mb-0">All Contracts</h6>
    </div>
    <div class="table-responsive">
        <table class="table provms-table mb-0">
            <thead>
                <tr>
                    <th>Contract ID</th>
                    <th>Title</th>
                    <th>Vendor</th>
                    <th>Value</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
                    {
                    <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                <tr><td colspan="@(User.IsInRole("Admin") || User.IsInRole("Procurement") ? 8 : 7)" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No contracts found.</td></tr>
                }
                @foreach (var c in Model)
                {
                var statusCls = c.Status switch {
                    ProVMSIT15.Models.ContractStatus.Active => "badge-active",
                    ProVMSIT15.Models.ContractStatus.Draft => "badge-draft",
                    ProVMSIT15.Models.ContractStatus.UnderNegotiation => "badge-negotiation",
                    ProVMSIT15.Models.ContractStatus.Expiring => "badge-expiring",
                    ProVMSIT15.Models.ContractStatus.Expired => "badge-expired",
                    _ => "badge-archived"
                };
                <tr>
                    <td><code class="small">CON-@c.ID.ToString("D4")</code></td>
                    <td class="fw-semibold">@c.ContractTitle</td>
                    <td>@c.Vendor?.CompanyName</td>
                    <td class="fw-bold text-primary">₱@c.TotalValue.ToString("N2")</td>
                    <td class="small">@c.StartDate.ToString("MMM dd, yyyy")</td>
                    <td class="small">@c.EndDate.ToString("MMM dd, yyyy")</td>
                    <td><span class="status-badge @statusCls">@c.Status.ToString().Replace("UnderNegotiation","Negotiation")</span></td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
                    {
                    <td>
                        <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.ID" />
                            <select name="status" class="form-select form-select-sm" style="width:auto">
                                @foreach (var s in Enum.GetValues<ProVMSIT15.Models.ContractStatus>())
                                {
                                    if (s == c.Status)
                                    {
                                    <option value="@s" selected>@s.ToString().Replace("UnderNegotiation","Under Negotiation")</option>
                                    }
                                    else
                                    {
                                    <option value="@s">@s.ToString().Replace("UnderNegotiation","Under Negotiation")</option>
                                    }
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">Update</button>
                        </form>
                    </td>
                    }
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* New Contract Modal — Admin C,R,U,D | Procurement C,R,U — Finance=R only, modal hidden *@
@if (User.IsInRole("Admin") || User.IsInRole("Procurement"))
{
<!-- New Contract Modal -->
<div class="modal fade" id="newContractModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#0f1c33;color:#fff">
                <h5 class="modal-title"><i class="bi bi-file-earmark-plus me-2"></i>New Contract</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Contract Title</label>
                            <input name="title" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Discount %</label>
                            <input name="discount" type="number" step="0.01" min="0" max="100" class="form-control" value="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start Date</label>
                            <input name="startDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End Date</label>
                            <input name="endDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Notes</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Create Contract</button>
                </div>
            </form>
        </div>
    </div>
</div>
}
